{
  "schemaVersion": 1,
  "id": "sample-report",
  "type": "change-report@1",
  "revision": 1,
  "brief": "task.md",
  "completion": {
    "kind": "until-disabled"
  },
  "trigger": {
    "kind": "after-settlement",
    "minIntervalHours": 168,
    "timezone": "UTC"
  },
  "limits": {
    "weeklyRuns": 2,
    "weeklySubtasks": 0,
    "maxSubtasksPerRun": 0,
    "maxExecutionMinutes": 60,
    "queueTimeoutHours": 24
  },
  "review": {
    "mode": "none"
  },
  "executionProfile": "local-worker@1",
  "outputBinding": "instance",
  "notifications": {
    "review": "none",
    "settled": "none",
    "failure": "none"
  },
  "inputs": [
    "inputs/notes.md"
  ],
  "parameters": {}
}
